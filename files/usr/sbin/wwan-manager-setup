#!/bin/bash
# wwan-manager-setup — (re)generate from /etc/default/wwan-manager:
#  - the ifupdown stanza for the LTE interface, and
#  - the udev rule that gives the modem's network interface that name.
# Run after changing LTE_IFACE or METRIC; the package runs it on install.
. /usr/share/wwan-manager/config.sh
# defaults < /etc/default/wwan-manager < environment
# MODEM_USB_IDS: EM7455; DW5811e with Dell's identity
load_config LTE_IFACE=wwan0 METRIC=700 MODEM_USB_IDS="1199:9071 413c:81b6"
[ -n "$LTE_IFACE" ] || { echo "wwan-manager-setup: LTE_IFACE is empty" >&2; exit 1; }
stanza=/etc/network/interfaces.d/wwan-manager
rule=/etc/udev/rules.d/90-wwan-manager-ifname.rules

old=$(sed -n 's/^iface \([^ ]*\) .*/\1/p' $stanza 2>/dev/null)
if [ -n "$old" ] && [ "$old" != "$LTE_IFACE" ]; then
	ifdown --force "$old" >/dev/null 2>&1 || true
fi

mkdir -p /etc/network/interfaces.d
cat > $stanza.new <<EOF
# Generated by wwan-manager-setup from /etc/default/wwan-manager — do not edit.
# LTE modem, dialed on demand: no auto/allow-hotplug, it only comes up via
# "ifup $LTE_IFACE". wwan-dial starts the data session and sets the address
# from the modem, with route metric $METRIC.
iface $LTE_IFACE inet manual
		up /usr/sbin/wwan-dial up
		down /usr/sbin/wwan-dial down
EOF
mv $stanza.new $stanza

{
	echo "# Generated by wwan-manager-setup from /etc/default/wwan-manager — do not edit."
	echo "# Network interface of the LTE modem is named $LTE_IFACE."
	for id in $MODEM_USB_IDS; do
		echo "SUBSYSTEM==\"net\", ACTION==\"add\", ATTRS{idVendor}==\"${id%:*}\", ATTRS{idProduct}==\"${id#*:}\", NAME=\"$LTE_IFACE\""
	done
} > $rule
command -v udevadm >/dev/null || exit 0
udevadm control --reload

# Rename the modem's interface if it is already present (udev only
# renames on "add", and only while the interface is down).
ids=$(sed -n 's/.*idVendor}=="\([0-9a-f]*\)", ATTRS{idProduct}=="\([0-9a-f]*\)".*/\1:\2/p' $rule)
for n in /sys/class/net/*; do
	name=$(basename "$n")
	[ "$name" = "$LTE_IFACE" ] && continue
	usb=$(readlink -f "$n/device/..")
	[ -r "$usb/idVendor" ] || continue
	echo "$ids" | grep -qx "$(cat "$usb/idVendor"):$(cat "$usb/idProduct")" || continue
	ip link set "$name" down
	udevadm trigger --action=add "$n"
	udevadm settle
	echo "wwan-manager-setup: renamed $name to $LTE_IFACE"
done
echo "wwan-manager-setup: $stanza defines $LTE_IFACE (metric $METRIC); $rule names the modem's interface $LTE_IFACE"
